# ATES-V1 Environment Configuration Template (SRS Section 3.1.4, SEC-8)
# Copy this file to `.env` and fill in your credentials.
# Never commit `.env` to version control.
# NOTE: ATES connects directly to PostgreSQL via SQLAlchemy (TCP port 5432 / 6543).
# Do NOT configure or use the Supabase client library or Supabase API keys.

# Supabase PostgreSQL direct / pooler connection URL (TLS required per Section 3.1.4)
DATABASE_URL=postgresql://postgres.-----@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# Optional: Local SQLite fallback for offline development (never use Supabase in automated tests)
# DATABASE_URL=sqlite:///./ates_local.db

# Application security settings (SRS Section 4.3 SEC-3, SEC-8)
JWT_SECRET_KEY=replace-with-a-cryptographically-random-256-bit-hex-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# React development server CORS origins (SRS Section 3.1.4)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
